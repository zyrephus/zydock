<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>zydock</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon.icns</string>
    <!-- No dock icon, no app switcher entry -->
    <key>LSUIElement</key>
    <true/>
    <!-- Needed to draw above other windows -->
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- Lets zydock query Music.app / Spotify for Now Playing info via AppleScript -->
    <key>NSAppleEventsUsageDescription</key>
    <string>zydock reads Now Playing info (title, artist, playback position) from Music and Spotify.</string>
    <!-- Required so zydock can watch the Desktop for new screenshots and surface them in the Tray tab. -->
    <key>NSDesktopFolderUsageDescription</key>
    <string>zydock watches your screenshot folder so new screenshots automatically appear in the Tray.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>zydock accesses files you drop into the Tray. It only reads paths you explicitly drag in.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>zydock accesses files you drop into the Tray. It only reads paths you explicitly drag in.</string>
</dict>
</plist>

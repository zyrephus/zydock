<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>zydock</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon.icns</string>
    <!-- No dock icon, no app switcher entry -->
    <key>LSUIElement</key>
    <true/>
    <!-- Needed to draw above other windows -->
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- Used to read Now Playing from Music/Spotify and to navigate Calendar.app to a selected day. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>zydock controls other apps to read Now Playing info from Music and Spotify, and to navigate Calendar to a selected day.</string>
    <!-- Required so zydock can watch the Desktop for new screenshots and surface them in the Tray tab. -->
    <key>NSDesktopFolderUsageDescription</key>
    <string>zydock watches your screenshot folder so new screenshots automatically appear in the Tray.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>zydock accesses files you drop into the Tray. It only reads paths you explicitly drag in.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>zydock accesses files you drop into the Tray. It only reads paths you explicitly drag in.</string>
    <!-- Read calendar events for the Home tab calendar widget. -->
    <key>NSCalendarsUsageDescription</key>
    <string>zydock displays your upcoming events on the Home tab.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>zydock displays your upcoming events on the Home tab.</string>
</dict>
</plist>
